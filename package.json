{
  "name": "cocekin",
  "version": "1.0.0",
  "description": "CoCekIn \u2014 the clan finder and player-profile hub for Clash of Clans players. Unofficial fan project.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node --watch --disable-warning=ExperimentalWarning --env-file-if-exists=.env server/index.js",
    "start": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env server/index.js",
    "build": "node scripts/build.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/*.test.js\"",
    "seed": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env scripts/seed.js",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.13.0"
  }
}
